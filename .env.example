# Core app
PORT=4000
NODE_ENV=production
APP_URL=http://localhost:4000
API_URL=http://localhost:4000

# Database
DATABASE_URL=file:./prisma/dev.db

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret

# Email / SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=Fun With Learn <noreply@example.com>

# AI / external providers
GEMINI_API_KEY=your_gemini_api_key_here

# Live classroom provider placeholders
LIVE_CLASS_PROVIDER=agora
LIVE_CLASS_API_KEY=your_live_class_key
LIVE_CLASS_API_SECRET=your_live_class_secret
